# Use the display name visible on YOUR LinkedIn profile (exact match).
MY_NAME=Your Exact LinkedIn Display Name
# Start in safe review mode: no clicks on Accept or Send.
DRY_RUN=true
POLL_SECONDS=15
MAX_ACCEPT_PER_CYCLE=5
MAX_REPLIES_PER_CYCLE=5

# Gemini is selected automatically when a key is set. Force local templates with local.
REPLY_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional verified facts about you/business for Gemini to use (single line).
BOT_CONTEXT=
# Also inspect read conversations whose latest messages are incoming and unanswered.
ONLY_UNREAD=false
